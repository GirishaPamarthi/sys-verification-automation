[system]
# Squish Installation paths for Integrity
# NOTE: Since interops release 1.5.0, these paths are now also being used for some Monaco library functions used with execute_remote_py_function
remote_py_dir=D:\squish\Squish_runtime\python310;C:\Program Files (x86)\squish_runtime\python310;C:\Program Files (x86)\squish_runtime\python310
remote_temp_dir=D:\Temp\;C:\Temp\
# Squish runner paths
squish_bin=C:\Program Files (x86)\squish_runtime\bin
squish_python_lib=C:\Program Files (x86)\squish_runtime\lib\python
# Squish server and startwinaut paths
# Note: squish_server, squish_startwinaut, local_squish_server and local_squish_startwinaut
# are used in attach_to_running_appplication() in the ApplicationManager
squish_server=D:\squish\squish_runtime\bin\squishserver
squish_startwinaut=D:\squish\squish_runtime\bin\startwinaut
local_squish_server=C:\Program Files (x86)\squish_runtime\bin\squishserver
local_squish_startwinaut=C:\Program Files (x86)\squish_runtime\bin\startwinaut

[Python]
comtypes_path=../shared/comtypes

[linac_id_reg_entry]
subkey=SOFTWARE\Elekta Oncology Systems Ltd\Linac
value=LinacId
hive=HLM

[build_reg_entry]
subkey=SOFTWARE\Elekta Oncology Systems Ltd\RTD
value=Build
hive=HLM

[attach]
rtdshell_batch_file=D:\squish\shell_scripts\StartRTDShell.bat
consolestart_batch_file=D:\squish\shell_scripts\StartConsolePrep.bat
servicecore_bat=D:\squish\shell_scripts\StartServiceCore.bat
# Integrity host (default CCP setup)
host=192.168.30.2
# Squish server port number
port=4322
fkpid_host=
direct_attach=

[application]
no_auto_start=ConsoleStart,RTDShell

[run_config]
use_headless_fkpid=
use_remote_fkpid=
show_fkpid_popup_prompts=True

[essi]
username=test
password=00799

[qa_user]
# Integrity user login credentials
username_service=service
password_service=service
username_clinical=super
password_clinical=super
